<div class="layout layout--row gap--medium">
  <!-- Standings -->
  <div class="stretch-x">
    <table class="tbl">
      {% for team in standings %}
        <tr>
          <td class="py--1 pr--1" style="width: 14px;">
            <span class="description">{{ team.overall_rank }}</span>
          </td>
          <td class="py--1 px--1" style="width: 18px;">
            <img src="{{ team.logo }}" width="18" height="18" class="image--contain" />
          </td>
          <td class="py--1 px--1">
            <span class="label label--small">{{ team.short_name }}</span>
          </td>
          <td class="py--1 px--1 nowrap text--right">
            <span class="label label--small">{{ team.record }}</span>
          </td>
          <td class="py--1 px--1 nowrap text--right">
            <span class="description">{{ team.gb }}</span>
          </td>
          <td class="py--1 pl--1 nowrap text--right">
            <span class="description">({{ team.streak }})</span>
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>

  <!-- Today's Games -->
  <div class="stretch-x pl--3 border-l-2">
    <div class="title title--small bold mb--2">Today's Games</div>

    {% if games_count == 0 %}
      <span class="description">No games scheduled today.</span>
    {% else %}
      <div class="grid grid--cols-2 gap--small">
        {% for game in games %}
          <div class="pb--1 border-b-1">
            <table class="tbl">
              <tr>
                <td class="py--1" style="width: 16px;">
                  <img src="{{ game.away.logo }}" width="16" height="16" class="image--contain" />
                </td>
                <td class="py--1 px--1">
                  <span class="label label--small bold">{{ game.away.short_name }}</span>
                </td>
                <td class="py--1 text--right nowrap">
                  <span class="description">{{ game.away.record }}</span>
                </td>
                {% if game.completed or game.in_progress %}
                  <td class="py--1 pl--1 text--right">
                    <span class="label label--small bold">{{ game.away.score }}</span>
                  </td>
                {% endif %}
              </tr>
              <tr>
                <td class="py--1" style="width: 16px;">
                  <img src="{{ game.home.logo }}" width="16" height="16" class="image--contain" />
                </td>
                <td class="py--1 px--1">
                  <span class="label label--small bold">{{ game.home.short_name }}</span>
                </td>
                <td class="py--1 text--right nowrap">
                  <span class="description">{{ game.home.record }}</span>
                </td>
                {% if game.completed or game.in_progress %}
                  <td class="py--1 pl--1 text--right">
                    <span class="label label--small bold">{{ game.home.score }}</span>
                  </td>
                {% endif %}
              </tr>
            </table>
            <div class="text--right">
              <span class="description text-sm">{{ game.time }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://a.espncdn.com/i/teamlogos/leagues/500/wnba.png" />
  <span class="title">WNBA Standings</span>
  <span class="instance">{{ date }}</span>
</div>
