<div class="layout layout--col">
  {% for conf in conferences %}
    <div class="conf-header label label--small mb--1 pb--1">{{ conf.abbr }}</div>
    <table class="tbl">
      {% for team in conf.teams limit: 5 %}
        <tr class="border-b-1">
          <td class="py--1 px--1" style="width: 14px;">
            <img src="{{ team.logo }}" width="14" height="14" class="image--contain" />
          </td>
          <td class="py--1 px--1">
            <span class="label label--small">{{ team.abbr }}</span>
          </td>
          <td class="py--1 text--right nowrap">
            <span class="label label--small">{{ team.record }}</span>
          </td>
        </tr>
      {% endfor %}
    </table>
  {% endfor %}
</div>

<div class="title_bar">
  <img class="image" src="https://a.espncdn.com/i/teamlogos/leagues/500/wnba.png" />
  <span class="title">WNBA</span>
  <span class="instance">{{ date_short }}</span>
</div>
